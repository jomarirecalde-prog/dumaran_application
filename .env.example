# Copy to .env and adjust for your machine (.env is gitignored).

# Application
APP_ENV=development
LOG_LEVEL=INFO

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_NAME=dumaran_hr
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Google OAuth (optional — or use config/oauth.php)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — or copy config/email.example.php to config/email.php)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dumaran.gov.ph
SMTP_FROM_NAME=Dumaran Hiring System
SMTP_REPLY_TO=support@dumaran.gov.ph
